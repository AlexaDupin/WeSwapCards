PORT=3001
PG_URL=postgresql://
CLERK_PUBLISHABLE_KEY=pk_test_x
CLERK_SECRET_KEY=sk_test_x
CLERK_SIGNING_SECRET=whsec_X
CORS_URL=http://localhost:3000

# Error tracking (instrument.js). Optional: without SENTRY_DSN, Sentry is a
# no-op and the app runs unchanged. Set it (per environment, e.g. on Render) to
# capture thrown exceptions with stack traces. Get the DSN from your Sentry
# project settings. NODE_ENV tags the environment shown in Sentry.
# SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzzz
# NODE_ENV=production

# Moderation report emails (services/mailer.js). Optional: without these the
# mailer no-ops and reports still land in the user_report table.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@example.com
SMTP_PASS=x
SMTP_FROM="WeSwapCards Moderation <contact@example.com>"
# Where report alerts are sent; defaults to contact@weswapcards.com if unset.
# MODERATION_EMAIL_TO=contact@example.com